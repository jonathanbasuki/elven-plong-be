# APP_ENV controls security checks at startup.
# In "dev" mode, INTERNAL_API_KEY and JWT_SECRET can be blank.
# Any other value (including "prod") requires both to be >= 32 characters,
# or the API will refuse to start.
APP_ENV=dev

# --- API ---
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://plong_elven:CHANGE_ME@127.0.0.1:5432/plong_elven

# JWT_SECRET must be >= 32 characters outside APP_ENV=dev.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# INTERNAL_API_KEY is used by camera workers to authenticate.
# Must be >= 32 characters outside APP_ENV=dev.
# A blank key rejects all worker calls, even in dev mode (fail-closed).
INTERNAL_API_KEY=

ZONES_PATH=zones.json
APNS_KEY_PATH=./secrets/AuthKey_XXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=true

# --- Worker ---
API_BASE_URL=http://127.0.0.1:8080
CAMERA_ID=
RTSP_URL=rtsp://username:password@cameraip/stream1
YOLO_WEIGHTS=models/yolo26l.pt
YOLO_DEVICE=mps
DRY_RUN=0
