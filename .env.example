# APP_ENV controls security checks at startup.
# In "dev" mode, INTERNAL_API_KEY and JWT_SECRET can be blank.
# Any other value (including "prod") requires both to be >= 32 characters,
# or the API will refuse to start.
APP_ENV=dev

# --- API ---
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://plong_elven:CHANGE_ME@127.0.0.1:5432/plong_elven

# JWT_SECRET must be >= 32 characters outside APP_ENV=dev.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# INTERNAL_API_KEY is used by the camera process to authenticate.
# Must be >= 32 characters outside APP_ENV=dev.
# A blank key rejects all camera calls, even in dev mode (fail-closed).
INTERNAL_API_KEY=

APNS_KEY_PATH=./secrets/AuthKey_XXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=true

# --- Camera ---
API_BASE_URL=http://127.0.0.1:8080
CAMERA_ID=
RTSP_URL=rtsp://username:password@cameraip/stream1
YOLO_WEIGHTS=models/yolo26l.pt
YOLO_DEVICE=mps
# Which point of a person's box decides their zone: bottom_center, center or top_center.
CAMERA_ANCHOR=bottom_center
DRY_RUN=0

# --- Task footage (src/plong_elven/services/footage_service.py) ---
# When a task completes, its video is cut from the MediaMTX recordings and
# uploaded to this Supabase Storage bucket.
SUPABASE_URL=https://SUPABASE_URL.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FOOTAGE_BUCKET=plong-task-footage
# Where MediaMTX writes its recordings (make mediamtx mounts ./recordings),
# the recorded path name, and the segment length set in infra/mediamtx.yml.
MEDIAMTX_RECORDINGS_DIR=./recordings
MEDIAMTX_RECORD_PATH=cam1
MEDIAMTX_RECORD_SEGMENT_SECONDS=2
